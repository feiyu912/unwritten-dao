{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unwritten-dao.dev/contracts/npc-observation.v1.schema.json",
  "title": "NpcObservation",
  "description": "Everything one NPC can perceive or knows at a decision point. Must never contain hidden world truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "npc_id",
    "tick",
    "world_version",
    "location_id",
    "self",
    "inventory",
    "visible_items",
    "visible_opportunities",
    "visible_npcs",
    "relationships",
    "beliefs",
    "known_locations",
    "memories",
    "recent_events",
    "goals",
    "active_action",
    "available_actions"
  ],
  "properties": {
    "schema_version": { "const": "npc-observation.v1" },
    "npc_id": { "type": "string", "format": "uuid" },
    "tick": { "type": "integer", "minimum": 0 },
    "world_version": { "type": "integer", "minimum": 0 },
    "location_id": { "type": "string", "minLength": 1 },
    "self": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "realm",
        "stage",
        "qi",
        "foundation",
        "health",
        "wealth",
        "lifespan_ticks",
        "birth_tick",
        "estimated_remaining_life_ticks",
        "traits"
      ],
      "properties": {
        "name": { "type": "string" },
        "realm": { "type": "integer", "minimum": 0 },
        "stage": { "type": "integer", "minimum": 0 },
        "qi": { "type": "integer", "minimum": 0 },
        "foundation": { "type": "number", "minimum": 0, "maximum": 1 },
        "health": { "type": "number", "minimum": 0, "maximum": 1 },
        "wealth": { "type": "integer", "minimum": 0 },
        "lifespan_ticks": { "type": "integer", "minimum": 1 },
        "birth_tick": { "type": "integer" },
        "estimated_remaining_life_ticks": { "type": "integer" },
        "traits": { "type": "object" }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "name", "kind"],
        "properties": {
          "item_id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "properties": { "type": "object" }
        }
      }
    },
    "visible_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "name", "kind"],
        "properties": {
          "item_id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "properties": { "type": "object" }
        }
      }
    },
    "visible_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opportunity_id", "name", "kind", "location_id", "active_until_tick"],
        "properties": {
          "opportunity_id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "location_id": { "type": "string" },
          "active_until_tick": { "type": "integer", "minimum": 0 },
          "reward_item_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "visible_npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["npc_id", "name", "realm", "stage", "alive"],
        "properties": {
          "npc_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "realm": { "type": "integer", "minimum": 0 },
          "stage": { "type": "integer", "minimum": 0 },
          "alive": { "type": "boolean" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["npc_id", "affinity", "trust", "fear", "respect", "debt"],
        "properties": {
          "npc_id": { "type": "string", "format": "uuid" },
          "affinity": { "type": "integer" },
          "trust": { "type": "integer" },
          "fear": { "type": "integer" },
          "respect": { "type": "integer" },
          "debt": { "type": "integer" }
        }
      }
    },
    "beliefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_key", "predicate", "object_value", "confidence"],
        "properties": {
          "subject_key": { "type": "string" },
          "predicate": { "type": "string" },
          "object_value": {},
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_event_id": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "known_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location_id", "name", "kind", "adjacent_ids"],
        "properties": {
          "location_id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "adjacent_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "tick", "summary", "importance", "emotional_valence"],
        "properties": {
          "event_id": { "type": "integer", "minimum": 1 },
          "tick": { "type": "integer", "minimum": 0 },
          "summary": { "type": "string" },
          "importance": { "type": "number", "minimum": 0, "maximum": 1 },
          "emotional_valence": { "type": "number", "minimum": -1, "maximum": 1 }
        }
      }
    },
    "recent_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "tick", "type", "summary"],
        "properties": {
          "event_id": { "type": "integer", "minimum": 1 },
          "tick": { "type": "integer", "minimum": 0 },
          "type": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goal_id", "kind", "status", "priority"],
        "properties": {
          "goal_id": { "type": "string" },
          "kind": { "type": "string" },
          "status": { "enum": ["active", "achieved", "failed", "abandoned"] },
          "priority": { "type": "number", "minimum": 0, "maximum": 1 },
          "params": { "type": "object" }
        }
      }
    },
    "active_action": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "remaining_ticks"],
      "properties": {
        "type": { "type": "string" },
        "remaining_ticks": { "type": "integer", "minimum": 0 }
      }
    },
    "available_actions": {
      "type": "array",
      "items": {
        "enum": [
          "wait",
          "move",
          "start_cultivation",
          "attempt_breakthrough",
          "transfer_item",
          "investigate",
          "enter_secret_realm",
          "claim_opportunity",
          "attack",
          "make_commitment"
        ]
      },
      "uniqueItems": true
    }
  }
}