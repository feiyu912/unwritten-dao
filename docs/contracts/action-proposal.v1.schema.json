{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unwritten-dao.dev/contracts/action-proposal.v1.schema.json",
  "title": "ActionProposal",
  "description": "What an agent wants to attempt. It is not authoritative: the simulator validates it and decides what actually happens.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "decision_id",
    "npc_id",
    "observed_world_version",
    "intent",
    "arguments",
    "valid_for_ticks",
    "memory_refs",
    "rationale_short",
    "confidence"
  ],
  "properties": {
    "schema_version": { "const": "action-proposal.v1" },
    "proposal_id": { "type": "string", "format": "uuid" },
    "decision_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "npc_id": { "type": "string", "format": "uuid" },
    "observed_world_version": { "type": "integer", "minimum": 0 },
    "goal_id": { "type": ["string", "null"] },
    "intent": {
      "enum": [
        "wait",
        "move",
        "start_cultivation",
        "attempt_breakthrough",
        "transfer_item",
        "investigate",
        "enter_secret_realm",
        "claim_opportunity",
        "attack"
      ]
    },
    "arguments": { "type": "object" },
    "valid_for_ticks": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "memory_refs": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "maxItems": 32
    },
    "rationale_short": { "type": "string", "minLength": 1, "maxLength": 500 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}