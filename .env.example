# Local PostgreSQL settings for docker compose.
# Copy to .env and change the password outside throwaway local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unwritten_dao
POSTGRES_PORT=5432

# Convenience URL for services/tools. The integration job overrides this with
# the throwaway unwritten_dao_test database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/unwritten_dao