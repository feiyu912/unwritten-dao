# Local PostgreSQL settings for docker compose.
# Copy to .env and change the password outside throwaway local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unwritten_dao
POSTGRES_PORT=5432

# Deterministic worldgen seed (server default: 42).
WORLD_SEED=42

# Convenience URL for the API server, Alembic, and DB-backed tools when the
# command loads this file (uvicorn --env-file .env / uv run --env-file .env).
# Docker Compose reads it automatically; plain `uv run python ...` does not.
# The integration job overrides this with the throwaway unwritten_dao_test database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/unwritten_dao

# --- LLM / dialogue ---------------------------------------------------------
# The decision and dialogue paths share these LLM_* values when both enable a
# model path. There is one endpoint/model here, not two independent remote
# models. Leave blank and point at your own local or hosted OpenAI-compatible
# /v1 chat-completions service. No default cloud endpoint or model is used.
# Never commit a real key.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_DIALOGUE_TEMPERATURE=0.7

# Background decisions: utility | llm-mock | decision-model | openai | openai-compatible | replay
AGENT_PROVIDER=utility

# Dialogue: utility | llm-mock | openai | openai-compatible (openai is an alias).
# Empty means "fall back to AGENT_PROVIDER", preserving legacy single-provider
# setups. Set it explicitly to run dialogue independently of background agents.
DIALOGUE_PROVIDER=

# --- Speech (ASR / TTS) -----------------------------------------------------
# Optional OpenAI-compatible speech endpoints. Values are intentionally blank.
ASR_BASE_URL=
ASR_MODEL=
ASR_API_KEY=

TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
TTS_API_KEY=

# --- Memory embeddings ------------------------------------------------------
# off | hash | openai
EMBEDDING_PROVIDER=off
EMBEDDING_DIM=768
# EMBEDDING_BASE_URL / EMBEDDING_API_KEY fall back to LLM_BASE_URL / LLM_API_KEY
# when unset; EMBEDDING_MODEL has no fallback.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
